{
  "name": "agenticos",
  "version": "0.1.0",
  "description": "Agentic OS: a local team of AI coding agents that work a git repository together.",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "doctor": "node src/doctor.js",
    "token": "node src/set-token.js",
    "cli": "node src/cli.js",
    "test": "node test/run-all.js",
    "dist": "electron-builder --win --publish never",
    "ctx": "node src/ctx.js",
    "replay": "node src/replay.js",
    "recycle": "node src/recycle.js",
    "prepare": "husky"
  },
  "build": {
    "appId": "dev.agenticos.app",
    "productName": "Agentic OS",
    "asar": false,
    "files": [
      "electron/**",
      "src/**",
      "ui/**",
      "skills/**",
      "agenticos.config.json",
      "roles.json",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "husky": "^9.1.7",
    "playwright": "^1.63.0",
    "playwright-core": "^1.63.0"
  },
  "engines": {
    "node": ">=24"
  }
}
