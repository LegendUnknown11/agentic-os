node_modules/
dist/
.agenticos/

# Daemon stdout/stderr from `electron/main.js` spawning the daemon detached —
# written next to the repo root on every launch, and each one names the repo
# path it served, so these are per-machine noise, not project state.
.agenticos-daemon-*.log

# Untracked, unreferenced by any code path, flagged across three sessions with
# no resolution — see HANDOFF.md. Ignored rather than deleted: not this app's
# call to make on the user's behalf.
/Background.jpg

# Per-machine identity and tool config, not project state. .agents/agenticos-id.json
# holds absolute paths to this machine's db, repo and vault — and agents run
# `git add -A`, so anything untracked here gets committed onto a branch and
# merged by whoever presses the button.
.agents/
agenticos.config.json.tmp
agenticos.config.json.broken

# Scratch databases from probing a CLI or the MCP server by hand. SQLite leaves
# -shm/-wal siblings behind, and a pair of them sat in this repo untracked for
# twelve days before anyone noticed.
.tmp-*

# Never commit credentials. The real token store lives outside the repo
# (<repoParent>/.agenticos/<repoName>/tokens.json), but guard these too in case
# someone puts one here.
tokens.json
.env
.env.*
*.credentials.json

# per-machine Claude Code state (machineID, userID, local project history)
.claude.json

# Playwright MCP session output: screenshots and page/console dumps from
# driving the UI in a real browser. Evidence for a session, not project state.
.playwright-mcp/

# The ARMS layer under .claude/ IS project state and is tracked deliberately.
# Everything else there is per-machine: sessions, backups, handoffs, launch
# ports, lock files. `.claude/*` rather than `.claude/` because git will not
# descend into an excluded directory, so the negations below need the parent
# reachable.
.claude/*
!.claude/arms/
!.claude/skills/
!.claude/routines/
